rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── 1. Uitnodigingen (Invites) ──────────────────────────────────────────
    // - Lezen: Iedereen die de link bezit (zodat de speler de welkomstpagina ziet)
    // - Aanmaken: Alleen ingelogde gebruikers (coach)
    // - Updaten/Claimen: Ingelogde gebruikers (Google of E-mail) die de link claimen
    match /invites/{token} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // ─── 2. Teams ─────────────────────────────────────────────────────────────
    // - Lezen: Iedereen met de teamcode
    // - Schrijven hoofd-document: Alleen ingelogde coaches
    match /teams/{teamCode} {
      allow read: if true;
      allow write: if request.auth != null;

      // ─── Speler-subcollectie ──────────────────────────────────────────────
      // - Lezen: Iedereen (coach heeft teamoverzicht nodig)
      // - Schrijven / Updaten: Alleen ingelogde accounts
      match /players/{playerId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // ─── 3. Gebruikersprofielen (Users) ───────────────────────────────────────
    // - Alleen de eigenaar kan zijn eigen account document lezen en schrijven
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
