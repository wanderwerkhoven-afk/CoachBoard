rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Teams (lezen is openbaar voor iedereen met de teamcode) ────────────
    // Spelers hoeven NIET ingelogd te zijn om de teamdata te lezen.
    // Schrijven is ook toegestaan zonder login (spelers slaan beschikbaarheid op).
    match /teams/{teamCode} {
      allow read: if true;          // Iedereen met de teamcode kan lezen
      allow write: if true;         // Spelers (zonder Google-login) kunnen ook schrijven
    }

    // ─── Gebruikers (alleen eigen data) ─────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
